{
  "manifest_version": 3,
  "name": "PureText YouTube 字幕",
  "version": "1.0.1",
  "description": "使用 Audio-IO 產生 SRT，並將字幕疊加在 YouTube 影片上。",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://gpuiapi.audio-io.com/*",
    "https://website-builder-pro--billlin0904.replit.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "在頁面中開啟 PureText 字幕",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://website-builder-pro--billlin0904.replit.app/auth/callback*"
      ],
      "js": ["oauth-callback.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "sidepanel.css",
        "sidepanel.js",
        "icons/icon-48.png"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
